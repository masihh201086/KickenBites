rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Kicken Bites Firestore rules
    //
    // IMPORTANT LIMITATION: this app has NO Firebase Authentication —
    // customer/delivery/admin login is client-side (phone+PIN / password).
    // So these rules CANNOT enforce "only the real admin may do X".
    // What they DO enforce:
    //   • the database is NOT wide-open test mode
    //   • each document must have the right shape / field types
    //   • nobody can DELETE data except the two deletes the app itself makes
    //   • unknown collections are denied by default
    // For true per-role control you must add Firebase Auth later.
    // ─────────────────────────────────────────────────────────────

    function isStr(v){ return v is string; }
    function isNum(v){ return v is number; }
    function has(data, field){ return field in data; }

    // ---- orders ----
    match /orders/{orderId} {
      allow read: if true;
      // create: must look like a real order
      allow create: if request.resource.data.keys().hasAll(['phone','items','status','total','date'])
                    && isStr(request.resource.data.phone)
                    && isNum(request.resource.data.total)
                    && isStr(request.resource.data.status)
                    && isStr(request.resource.data.date);
      // update: allowed (status changes, assignments) but can't wipe the phone/date identity
      allow update: if request.resource.data.phone == resource.data.phone
                    && request.resource.data.date == resource.data.date;
      allow delete: if false; // orders are never hard-deleted, only status→cancelled
    }

    // ---- customers ---- (PIN is a SHA-256 hash, never plaintext)
    match /customers/{phone} {
      allow read: if true;
      allow create, update: if request.resource.data.phone == phone;
      allow delete: if false;
    }

    // ---- wallets ----
    match /wallets/{phone} {
      allow read: if true;
      allow create, update: if request.resource.data.phone == phone
                            && isNum(request.resource.data.balance);
      allow delete: if false;
    }

    // ---- dailyMenu ---- (stock docs; app resets an override by deleting)
    match /dailyMenu/{date} {
      allow read: if true;
      allow create, update: if has(request.resource.data,'items');
      allow delete: if true; // admin "Reset to default" removes the override doc
    }

    // ---- config/security ---- (admin password hash + lockout counter)
    // BUG-01/BUG-07: password ka PBKDF2 hash yahan rehta hai, device par nahi.
    // Lock ek baar lag jaaye to expiry se pehle koi seedhe Firestore se saaf na kar sake —
    // ye rule enforceable hai (request.time ko rules khud dekhte hain).
    match /config/security {
      allow read: if true;
      allow create: if request.resource.data.pwdHash is string
                    && request.resource.data.pwdSalt is string;
      allow update: if request.resource.data.pwdHash is string
                    && request.resource.data.pwdSalt is string
                    && (
                         !('lockUntil' in resource.data)
                         || resource.data.lockUntil == 0
                         || request.time.toMillis() > resource.data.lockUntil
                         || request.resource.data.lockUntil >= resource.data.lockUntil
                       );
      allow delete: if false;
    }

    // ---- config ---- (baaki settings: menu/master/upi etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if docId != 'security';   // security doc ke apne rules upar hain
      allow delete: if false;
    }

    // ---- deliveryBoys ---- (app supports removeBoy)
    match /deliveryBoys/{phone} {
      allow read: if true;
      allow create, update: if request.resource.data.phone == phone;
      allow delete: if true;  // admin removeBoy
    }

    // ---- delivery live status ----
    match /delivery/{docId} {
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }

    // ---- presence / boyNotifications / wishlist ----
    match /presence/{phone} {
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }
    match /boyNotifications/{id} {
      allow read: if true;
      allow write: if true;
      allow delete: if false;
    }
    match /wishlist/{id} {
      allow read: if true;
      allow write: if true;
      allow delete: if true;  // votes can be withdrawn
    }

    // ---- partyBookings ---- (BUG-06: party.html se aayi booking ka record)
    // Doc id date_phone hai. Booking me koi secret nahi hota, aur delete band hai —
    // admin sirf status:'dismissed' karke list se hata sakta hai, record rehta hai.
    match /partyBookings/{id} {
      allow read: if true;
      allow write: if request.resource.data.phone is string
                   && request.resource.data.partyDate is string
                   && request.resource.data.status is string;
      allow delete: if false;
    }

    // ---- pinResetRequests ---- (customer/boy -> admin, in-app notification)
    // Sirf ek chhoti si request parchi. Isme koi PIN ya secret nahi jaata,
    // aur doc id role_phone hai isliye ek bande ki ek hi entry banti hai.
    match /pinResetRequests/{id} {
      allow read: if true;
      allow write: if request.resource.data.phone is string
                   && request.resource.data.status is string;
      allow delete: if false;
    }

    // ---- ratings ---- (item reviews shown on customer cards)
    // ⚠️ This collection was MISSING from the ruleset, so it fell through to the
    // default-deny at the bottom. Every read AND write of a rating was being
    // rejected — which is why every item showed "Be first to review" and why new
    // reviews silently vanished. Old ratings written before the rules went live
    // are still in the database and reappear once this is published.
    // hidden:true is how the admin hides an abusive review; delete stays off.
    match /ratings/{id} {
      allow read: if true;
      allow write: if request.resource.data.itemId is string
                   && request.resource.data.rating is number
                   && request.resource.data.rating >= 1
                   && request.resource.data.rating <= 5;
      allow delete: if false;
    }

    // ---- Session 27: customer -> admin request collections ----
    // Chhoti request parchiyan (helpdesk message, invoice request, app feedback).
    // Koi secret nahi. status string zaroori; admin inhe status:'done' se nipatता hai.
    // ⚠️ Ye teen collections NAYE hain — rules publish karna zaroori, warna default-deny
    // se writes silently fail honge (jaise ratings/pinReset me hua tha).
    match /helpdeskMessages/{id} {
      allow read: if true;
      allow write: if request.resource.data.status is string;
      allow delete: if false;
    }
    match /invoiceRequests/{id} {
      allow read: if true;
      allow write: if request.resource.data.status is string;
      allow delete: if false;
    }
    match /appFeedback/{id} {
      allow read: if true;
      allow write: if request.resource.data.status is string;
      allow delete: if false;
    }

    // ---- everything else: DENY ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
